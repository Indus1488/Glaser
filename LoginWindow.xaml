<Window x:Class="GradeApp.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход" Height="300" Width="360"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Вход в систему" FontSize="16" Margin="0,0,0,15"/>

        <TextBlock Grid.Row="1" Text="Роль:" Margin="0,0,0,3"/>
        <ComboBox x:Name="RoleCombo" Grid.Row="2" SelectedIndex="0" Margin="0,0,0,10">
            <ComboBoxItem Content="Преподаватель"/>
            <ComboBoxItem Content="Студент"/>
        </ComboBox>

        <TextBlock Grid.Row="3" Text="Логин:" Margin="0,0,0,3"/>
        <TextBox x:Name="LoginBox" Grid.Row="4" Text="ivanov" Margin="0,0,0,10" Padding="4"/>

        <StackPanel Grid.Row="5">
            <TextBlock Text="Пароль:" Margin="0,0,0,3"/>
            <PasswordBox x:Name="PasswordBox" Password="12345" Padding="4"/>
        </StackPanel>

        <Button Grid.Row="6" Content="Войти" Width="100" Height="28"
                HorizontalAlignment="Right" Margin="0,15,0,0"
                Click="Login_Click"/>
    </Grid>
</Window>